rules_version = '2';

// Birkat Avraham — Firebase Storage security rules (gallery / staff photos).
// Public can READ images; only editors (the gabbaim) can upload/replace.
//
// Publish: Firebase Console → Storage → Rules → Publish
// (or: firebase deploy --only storage)

service firebase.storage {
  match /b/{bucket}/o {

    function isEditor() {
      return request.auth != null
        && request.auth.token.email in [
          'kolelbirkatavraham@gmail.com'
        ];
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if isEditor();
    }
  }
}
