rules_version = '2';

// Birkat Avraham — Firestore security rules.
// Public site can READ all content; only editors (the gabbaim) can WRITE.
//
// Write access = authenticated AND email is in the editor allowlist below.
// (No custom claim / service account needed: only accounts you create in the
// Firebase console — and whose password you set — can sign in, and only the
// listed emails can write. Add more gabbai emails to the list as needed.)
//
// Publish: Firebase Console → Firestore Database → Rules → Publish
// (or: firebase deploy --only firestore:rules)

service cloud.firestore {
  match /databases/{database}/documents {

    function isEditor() {
      return request.auth != null
        && request.auth.token.email in [
          'kolelbirkatavraham@gmail.com'
        ];
    }

    // All content (collections + singletons): world-readable, editor-writable.
    match /{document=**} {
      allow read: if true;
      allow write: if isEditor();
    }
  }
}
