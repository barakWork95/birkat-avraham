# Copy to `.env` for production/default. For the staging project, create
# `.env.staging` with the staging Firebase config (see ENVIRONMENTS.md); it
# layers on top of `.env` for `vite --mode staging` builds.

# ── Data source ────────────────────────────────────────────────
# 'local' (default) = localStorage demo mode. 'firebase' = live Firestore.
VITE_DATA_PROVIDER=local

# ── Admin passcode (LOCAL demo mode only) ──────────────────────
# Not real security — just keeps /admin out of casual view in the demo.
VITE_ADMIN_PASSCODE=brachot

# ── Nedarim Plus (donations) ───────────────────────────────────
# ApiValid token from the Nedarim Plus (matara.pro) mosad control panel.
# When set, the donation widget loads the real Nedarim iframe and charges live.
# When empty, the widget stays in safe demo mode (mocked success, no charge).
# Note: in a client-only app this value is exposed to the browser regardless;
# keeping it in .env keeps it out of the committed source and swappable.
VITE_NEDARIM_API_VALID=

# ── Firebase web config (fill during the Firebase sprint) ──────
# From Firebase Console → Project settings → Your apps → Web app.
# These are public identifiers (safe to ship); security is enforced by rules.
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_SENDER_ID=
VITE_FB_APP_ID=
VITE_FB_MEASUREMENT_ID=
