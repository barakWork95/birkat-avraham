# ── Data source ────────────────────────────────────────────────
# 'local' (default) = localStorage demo mode. 'firebase' = live Firestore.
VITE_DATA_PROVIDER=local

# ── Admin passcode (LOCAL demo mode only) ──────────────────────
# Not real security — just keeps /admin out of casual view in the demo.
VITE_ADMIN_PASSCODE=brachot

# ── Firebase web config (fill during the Firebase sprint) ──────
# From Firebase Console → Project settings → Your apps → Web app.
# These are public identifiers (safe to ship); security is enforced by rules.
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_SENDER_ID=
VITE_FB_APP_ID=
